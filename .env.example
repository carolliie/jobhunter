# --- Telegram ---
# Token criado no @BotFather
TELEGRAM_BOT_TOKEN=
# Seu ID numérico (descubra com @userinfobot). Só este usuário acessa o bot.
TELEGRAM_USER_ID=

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# --- Banco (docker compose up -d) ---
DATABASE_URL=postgresql://jobhunter:jobhunter@localhost:5434/jobhunter?schema=public

# --- Opcionais ---
# Intervalo da busca automática em minutos (divisor de 60 ou múltiplo de 60)
SEARCH_INTERVAL_MINUTES=30
# Executa uma busca assim que o bot inicia
RUN_ON_START=true
# Máximo de vagas notificadas por execução (protege créditos de IA e evita flood)
MAX_NOTIFICATIONS_PER_RUN=10
# Arquivo de filtros/perfil
PROFILE_PATH=config/profile.json
LOG_LEVEL=info

# --- Fontes com chave (opcionais) ---
# Adzuna (vagas no Brasil): https://developer.adzuna.com  -> Register
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# JSearch via RapidAPI (agrega LinkedIn/Indeed/Glassdoor): https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_RAPIDAPI_KEY=
# Jooble (vagas no Brasil, chave gratuita por formulário): https://jooble.org/api/about
JOOBLE_API_KEY=
# ZenRows Fetch API (coleta protegida do LinkedIn): https://app.zenrows.com
ZENROWS_API_KEY=
